DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DB_PATH=data/foresight.db

# 宏观基线数据（CPI/利率/原油库存，2026-08-12 接入；无 key 时降级跳过）
FRED_API_KEY=
EIA_API_KEY=

# 新闻检索数据源（无 key 时降级仅用 GDELT）
NEWSAPI_KEY=

# ForecastBench 官方提交渠道（Metaculus；未配置时只做本地回测）
METACULUS_API_TOKEN=
FORECASTBENCH_GCS_BUCKET=

# 可选：禁用指定数据源（逗号分隔，如 gdelt,newsapi）
# FORESIGHT_DISABLE_SOURCES=

# 可选调优（默认值见 src/predictor/config.py）
# LLM_MODEL=deepseek-chat
# LLM_TEMPERATURE=0.0
# MAX_RETRIES=2
# TIMEOUT_SECONDS=60.0
