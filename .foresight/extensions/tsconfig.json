{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "typeRoots": ["../../shell/pi/node_modules/@types"],
    "baseUrl": ".",
    "paths": {
      "@earendil-works/pi-coding-agent": [
        "../../shell/pi/packages/coding-agent/dist/index.d.ts"
      ],
      "typebox": ["../../shell/pi/node_modules/typebox/build/index.d.mts"]
    }
  },
  "include": ["./**/*.ts"]
}
